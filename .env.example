# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Live mode: answers generated by Claude. Without credentials the app runs in
# scripted-demo / retrieval-only mode. Use ONE of the two options.

# Option A: Claude API
ANTHROPIC_API_KEY=

# Option B: Amazon Bedrock (Claude models must be enabled in this region)
# AWS_BEARER_TOKEN_BEDROCK=
# AWS_REGION=us-east-1

# Optional overrides (defaults shown)
# SPARRING_PROVIDER=auto           # auto | anthropic | bedrock
# SPARRING_LLM_MODE=auto            # auto | anthropic | offline
# SPARRING_MODEL=claude-opus-5-5    # anthropic.claude-opus-5-5 on Bedrock
# SPARRING_EFFORT_GAPS=high
# SPARRING_EFFORT_CHAT=low
# SPARRING_EFFORT_STRUCTURE=medium
# SPARRING_FALLBACKS=default        # server-side refusal fallback: default | off
# SPARRING_RAW_DIR=./cases_raw
# SPARRING_ACCEPT_SESSION_LOGS=0    # 1 = accept POST /api/sessions (user studies)
