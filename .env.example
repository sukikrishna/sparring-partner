# Copy to .env and fill in. .env is gitignored; never commit real keys.

# Live mode: answers generated by Claude. Without a key the app runs in
# scripted-demo / retrieval-only mode.
ANTHROPIC_API_KEY=

# Optional overrides (defaults shown)
# SPARRING_LLM_MODE=auto            # auto | anthropic | offline
# SPARRING_MODEL=claude-opus-5-5
# SPARRING_EFFORT_GAPS=high
# SPARRING_EFFORT_CHAT=low
# SPARRING_EFFORT_STRUCTURE=medium
# SPARRING_FALLBACKS=default        # server-side refusal fallback: default | off
# SPARRING_RAW_DIR=./cases_raw
# SPARRING_ACCEPT_SESSION_LOGS=0    # 1 = accept POST /api/sessions (user studies)
